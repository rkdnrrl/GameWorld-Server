generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 유저 프로필 (Supabase auth.users.id 와 연결)
model Profile {
  id         String    @id          // = Supabase auth.users.id
  username   String    @unique @db.VarChar(30)
  isOperator Boolean   @default(false)
  bio        String?   @db.VarChar(300)
  profileImageUrl String? @db.VarChar(400)
  websiteUrl String?   @db.VarChar(200)
  /// 팔로워/팔로잉 카운터 (denormalized)
  followerCount  Int   @default(0)
  followingCount Int   @default(0)
  createdAt  DateTime  @default(now())

  characters Character[]
  worlds     World[]
  assets     Asset[]
  prefabs    Prefab[]
  scriptComponents ScriptComponent[]
  followers  UserFollow[] @relation("Followee")  // 나를 팔로우하는 사람들
  following  UserFollow[] @relation("Follower")  // 내가 팔로우하는 사람들

  @@map("profiles")
}

/// 알림
model Notification {
  id        String    @id @default(cuid())
  userId    String                                                // 받는 사람
  type      String                                                // 'asset_liked','user_followed','asset_imported','report_resolved','asset_auto_hidden'
  payload   Json      @default("{}")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

/// 폴더 팩 — 폴더를 발행 단위로 묶음
model FolderPack {
  id            String   @id @default(cuid())
  creatorId     String
  path          String                                     // "/캐릭터/주인공"
  isPublic      Boolean  @default(false)
  description   String?  @db.VarChar(500)
  coverAssetId  String?
  importCount   Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([creatorId, path])
  @@map("folder_packs")
}

/// 유저 팔로우 (followerId → followeeId)
model UserFollow {
  followerId String
  followeeId String
  follower   Profile  @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  followee   Profile  @relation("Followee", fields: [followeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([followerId, followeeId])
  @@index([followeeId])
  @@index([followerId])
  @@map("user_follows")
}

/// 캐릭터 외형 (유저당 1개)
model Character {
  id         String   @id @default(cuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String   @db.VarChar(30)
  /// { bodyColor, skinColor, hairColor, eyeColor, hairStyle }
  appearance Json     @default("{}")
  isActive   Boolean  @default(false) @map("is_active")
  isPublic   Boolean  @default(false) @map("is_public")
  shareSlug  String?  @unique @map("share_slug")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, isActive])
  @@index([isPublic, updatedAt])
  @@map("characters")
}

/// 유저가 만든 3D 맵/월드
model World {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Profile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(100)
  description  String?  @db.VarChar(500)
  thumbnailUrl String?  @db.VarChar(400)
  /// { objects: [{ assetId, x, y, z, rx, ry, rz, sx, sy, sz }], terrain: {} }
  mapData      Json     @default("{\"objects\":[]}")
  isPublic     Boolean  @default(false)
  playCount    Int      @default(0)
  /// 'personal' = 각자 자기 DO 인스턴스 (홈허브용). 'multi' = 공개 세션 매칭.
  kind         String   @default("multi") @db.VarChar(20)
  /// 세션당 최대 인원. 호스트가 새 세션 만들 때 cap 으로 사용.
  maxPlayers   Int      @default(50)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublic, playCount(sort: Desc)])
  @@index([creatorId])
  @@map("worlds")
}

/// 맵별 영구 데이터 저장 (KV). userId NULL = 맵 전역(모두 공유), userId 있음 = 플레이어 개인.
/// 스크립트의 data.save/load/list 가 이걸 read/write. (mapId, userId, key) unique 로 upsert.
model WorldData {
  id        String   @id @default(cuid())
  mapId     String   @db.VarChar(40)
  userId    String?  @db.VarChar(40)   // NULL = 맵 전역. 있으면 플레이어 개인
  key       String   @db.VarChar(120)
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([mapId, userId, key])
  @@index([mapId, userId])
  @@map("world_data")
}

/// 유저 정의 스크립트 컴포넌트 (Unity MonoBehaviour 비슷).
/// 부착하면 오브젝트에 그 동작 발현. 한 컴포넌트를 여러 오브젝트에 부착 가능.
model ScriptComponent {
  id          String   @id @default(cuid())
  creatorId   String
  creator     Profile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(60)
  icon        String?  @db.VarChar(8)  // 이모지 (선택)
  description String?  @db.VarChar(300)
  /// onStart/onUpdate/onGrab/onRelease/onNetEvent 등 정의. props.<key> 접근 가능.
  code        String   @db.Text
  /// 운영자가 만든 "공식" 컴포넌트 — 모든 유저가 picker 에서 사용 가능.
  /// 일반 유저는 false 만 만들 수 있음 (자기 컴포넌트). 운영자가 true 로 승격 가능.
  isOfficial  Boolean  @default(false)
  /// props 스키마 — [{ key, label, type: 'number'|'string'|'boolean'|'enum', default, options? }]
  /// 비어있으면 Studio 가 free-form key:value 입력 UI 로 fallback.
  propsSchema Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([creatorId, updatedAt(sort: Desc)])
  @@index([isOfficial, updatedAt(sort: Desc)])
  @@map("script_components")
}

/// 스튜디오 프리팹 — 오브젝트(+components+script+...) 스냅샷.
/// V1: 인스턴스는 독립 복사본 (링크 X). V2+ 에서 instanceOf/version 추가해 update-propagation 가능.
model Prefab {
  id           String   @id @default(cuid())
  creatorId    String
  creator      Profile  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  name         String   @db.VarChar(100)
  thumbnailUrl String?  @db.VarChar(400)
  /// { version: 1, root: { kind, position, ..., components, script, ... } }
  /// V2 에서 multi-object 지원 시 root → children 트리로 확장
  payload      Json
  /// 향후 마켓플레이스/공유용 (V1 은 항상 false)
  isPublic     Boolean  @default(false)
  importCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([creatorId, updatedAt(sort: Desc)])
  @@index([isPublic, importCount(sort: Desc)])
  @@map("prefabs")
}

/// 3D 에셋 (Meshy AI 생성 또는 시스템 기본 에셋)
model Asset {
  id           String   @id @default(cuid())
  creatorId    String?                         // null = 시스템 에셋
  creator      Profile? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  name         String   @db.VarChar(100)
  prompt       String?  @db.VarChar(500)       // Meshy AI 프롬프트
  modelUrl     String   @db.VarChar(400)       // R2 URL
  thumbnailUrl String?  @db.VarChar(400)
  meshyTaskId  String?  @db.VarChar(100)
  polyCount    Int?
  isPublic     Boolean  @default(false)
  /// 머티리얼/텍스처 설정 — DEPRECATED: metadata.materialConfig 로 이전됨
  materialConfig Json?
  /// 타입(asset_kinds.id) — 'model','image','audio','video',...
  kind         String?
  kindRef      AssetKind? @relation(fields: [kind], references: [id], onDelete: SetNull)
  /// 타입별 메타데이터 (3D=materialConfig, image=width/height, audio=duration ...)
  metadata     Json?    @default("{}")
  /// 사용자 태그
  tags         String[] @default([])
  /// 가상 폴더 경로 (예: "/캐릭터/주인공")
  folder       String?
  fileSize     BigInt?
  /// 마켓플레이스 — 좋아요 수
  likeCount    Int      @default(0)
  /// 마켓플레이스 — 다른 유저가 내 라이브러리로 가져간 횟수
  importCount  Int      @default(0)
  /// 누적 신고수 (자동 hide 임계 판단)
  reportCount  Int      @default(0)
  /// 현재 버전 번호 (asset_versions 의 최신)
  currentVersion Int    @default(1)
  likes        AssetLike[]
  reports      AssetReport[]
  versions     AssetVersion[]
  createdAt    DateTime @default(now())

  @@index([creatorId])
  @@index([isPublic])
  @@index([kind])
  @@index([folder])
  @@index([creatorId, createdAt])
  @@map("assets")
}

/// 좋아요 (유저↔에셋 N:M)
model AssetLike {
  userId    String
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, assetId])
  @@index([userId])
  @@index([assetId])
  @@map("asset_likes")
}

/// 에셋 버전 히스토리
model AssetVersion {
  id           String   @id @default(cuid())
  assetId      String
  asset        Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version      Int                                 // 1부터, 순차
  modelUrl     String
  thumbnailUrl String?
  fileSize     BigInt?
  note         String?  @db.VarChar(300)
  createdAt    DateTime @default(now())

  @@unique([assetId, version])
  @@index([assetId, createdAt])
  @@map("asset_versions")
}

/// 에셋 신고 (모더레이션)
model AssetReport {
  id          String   @id @default(cuid())
  assetId     String
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  reporterId  String                                              // 신고한 유저
  reason      String                                              // 'inappropriate','copyright','spam','malware','other'
  comment     String?  @db.VarChar(500)
  status      String   @default("pending")                        // 'pending','dismissed','resolved'
  resolvedBy  String?                                             // 운영자 userId
  resolvedAt  DateTime?
  resolution  String?                                             // 'dismiss','hide','delete'
  createdAt   DateTime @default(now())

  @@unique([reporterId, assetId])
  @@index([status, createdAt])
  @@map("asset_reports")
}

/// 전역 설정 (운영자 관리) — key/value 싱글톤. 예: homeHubWorldId
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_config")
}

/// 에셋 타입 정의 — 운영자가 동적으로 추가/관리
model AssetKind {
  id          String   @id                       // 'model','image','audio'
  label       String
  icon        String?
  extensions  String[]                            // ['fbx','glb']
  mimeTypes   String[] @default([])               // 검증용 prefix
  maxSizeMb   Int      @default(50)
  sortOrder   Int      @default(0)
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  assets      Asset[]

  @@map("asset_kinds")
}

// ─────────────────────────────────────────────────────────────
// 게임 / 커뮤니티 / 공지 — 라우트가 typed client 로 사용하는 모델.
// 테이블은 Supabase 에 이미 존재(컬럼은 prisma db pull 인트로스펙션 기준).
// profiles(Profile) 와 별개로, games/community 작성자는 users(User) 테이블 사용.
// ─────────────────────────────────────────────────────────────

/// 커스텀 계정 테이블 (games·community 작성자). nickname 보유. profiles 와 별개.
model User {
  id                String             @id
  nickname          String             @unique
  games             Game[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]

  @@map("users")
}

/// UGC 게임 메타 (official + community)
model Game {
  slug         String    @id
  ownerUserId  String?
  title        String
  description  String    @default("")
  emoji        String    @default("🎮")
  kind         String    @default("community")
  status       String    @default("pending")
  category     String    @default("other")
  genre        String?
  storagePath  String    @default("")
  externalUrl  String?
  thumbnailUrl String?
  screenshots  Json      @default("[]")
  tags         Json      @default("[]")
  statusUrl    String?
  maxPlayers   Int       @default(1)
  playCount    Int       @default(0)
  likeCount    Int       @default(0)
  version      Int       @default(1)
  rejectReason String?
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt  DateTime? @db.Timestamptz(6)
  owner        User?     @relation(fields: [ownerUserId], references: [id])

  @@index([status, kind, createdAt])
  @@map("games")
}

/// 게임 장르 (운영자 관리)
model GameGenre {
  slug      String   @id
  labelKo   String
  labelEn   String
  emoji     String   @default("🎮")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("game_genres")
}

/// 게임 카테고리 (운영자 관리)
model GameCategory {
  slug      String   @id
  labelKo   String
  labelEn   String
  emoji     String   @default("🎮")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("game_categories")
}

/// 자유게시판 게시물
model CommunityPost {
  id        String             @id @default(dbgenerated("(gen_random_uuid())::text"))
  userId    String?
  title     String
  content   String
  category  String             @default("free")
  views     Int                @default(0)
  isPinned  Boolean            @default(false)
  createdAt DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt DateTime           @default(now()) @db.Timestamptz(6)
  user      User?              @relation(fields: [userId], references: [id])
  comments  CommunityComment[]

  @@index([category, createdAt])
  @@map("community_posts")
}

/// 자유게시판 댓글
model CommunityComment {
  id        BigInt        @id @default(autoincrement())
  postId    String
  userId    String?
  content   String
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id])

  @@map("community_comments")
}

/// 공지사항 · 패치노트
model Announcement {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  title     String   @db.VarChar(120)
  body      String
  kind      String   @default("notice") @db.VarChar(20)
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([pinned, createdAt])
  @@map("announcements")
}
